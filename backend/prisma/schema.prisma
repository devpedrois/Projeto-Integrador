generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  comprador
  artesao
  admin
}

enum StatusPedido {
  pendente
  confirmado
  cancelado
}

enum MetodoPagamento {
  pix_simulado
}

enum StatusPagamento {
  aprovado
  recusado
}

enum StatusIntencao {
  pendente
  publicada
  processada
  falha
}

enum TipoNotificacao {
  novo_pedido
}

// CHECKs de dominio e o indice unico funcional lower(email) vivem em SQL
// manual nas migrations: o Prisma 7.10 nao os expressa no schema.
model Usuario {
  id            String         @id @default(uuid()) @db.Uuid
  nome          String
  email         String         @unique
  senhaHash     String
  papel         PapelUsuario   @default(comprador)
  ativo         Boolean        @default(true)
  criadoEm      DateTime       @default(now()) @db.Timestamptz(3)
  perfilArtesao PerfilArtesao?
  carrinho      Carrinho?
  produtos      Produto[]      @relation("ProdutosDoArtesao")
  pedidos       Pedido[]
  avaliacoes    Avaliacao[]
  notificacoes  Notificacao[]
}

// Especializacao 1:0..1 de Usuario (papel = artesao). Chave primaria
// compartilhada expressa a cardinalidade sem FK redundante.
model PerfilArtesao {
  usuarioId          String   @id @db.Uuid
  historia           String?
  tecnicaPrincipalId String?
  regiaoId           String?
  tecnicaPrincipal   Tecnica? @relation(fields: [tecnicaPrincipalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  regiao             Regiao?  @relation(fields: [regiaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  foto               String?
  completo           Boolean  @default(false)
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([regiaoId])
}

model Categoria {
  id       String    @id @default(uuid()) @db.Uuid
  nome     String    @unique
  produtos Produto[]
}

model Tecnica {
  id       String          @id
  nome     String          @unique
  produtos Produto[]
  perfis   PerfilArtesao[]
}

model Regiao {
  id     String          @id
  nome   String          @unique
  perfis PerfilArtesao[]
}

model Produto {
  id                 String         @id @default(uuid()) @db.Uuid
  nome               String
  artesaoId          String         @db.Uuid
  categoriaId        String         @db.Uuid
  tecnicaId          String
  tecnica            Tecnica        @relation(fields: [tecnicaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  descricao          String
  preco              Decimal        @db.Decimal(10, 2)
  quantidadeEstoque  Int
  ativo              Boolean        @default(true)
  desativadoPorAdmin Boolean        @default(false)
  criadoEm           DateTime       @default(now()) @db.Timestamptz(3)
  artesao            Usuario        @relation("ProdutosDoArtesao", fields: [artesaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoria          Categoria      @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fotos              ProdutoFoto[]
  itensCarrinho      ItemCarrinho[]
  itensPedido        ItemPedido[]
  avaliacoes         Avaliacao[]

  @@index([artesaoId])
  @@index([categoriaId])
  @@index([tecnicaId])
  @@index([nome(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "Produto_nome_trgm_idx")
  @@index([descricao(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "Produto_descricao_trgm_idx")
}

model ProdutoFoto {
  id        String  @id @default(uuid()) @db.Uuid
  produtoId String  @db.Uuid
  url       String
  ordem     Int     @default(0)
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([produtoId, ordem])
}

// Especializacao 1:0..1 de Usuario (papel = comprador), mesmo padrao de
// chave compartilhada de PerfilArtesao.
model Carrinho {
  usuarioId    String         @id @db.Uuid
  atualizadoEm DateTime       @updatedAt @db.Timestamptz(3)
  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  itens        ItemCarrinho[]
}

model ItemCarrinho {
  id            String   @id @default(uuid()) @db.Uuid
  carrinhoId    String   @db.Uuid
  produtoId     String   @db.Uuid
  quantidade    Int
  precoUnitario Decimal  @db.Decimal(10, 2)
  carrinho      Carrinho @relation(fields: [carrinhoId], references: [usuarioId], onDelete: Cascade, onUpdate: Cascade)
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([carrinhoId, produtoId])
  @@index([produtoId])
}

model Pedido {
  id                  String               @id @default(uuid()) @db.Uuid
  // Legado do backend minimo de FCCPD, a remover na Sprint 6. compradorId e
  // a FK real e obrigatoria (ver docs/docs auxiliares/DATA_MODEL.md).
  compradorRef        String?
  compradorId         String               @db.Uuid
  numero              String?              @unique
  status              StatusPedido         @default(pendente)
  total               Decimal?             @db.Decimal(10, 2)
  criadoEm            DateTime             @default(now()) @db.Timestamptz(3)
  comprador           Usuario              @relation(fields: [compradorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  itens               ItemPedido[]
  pagamento           Pagamento?
  intencaoNotificacao IntencaoNotificacao?
  notificacoes        Notificacao[]

  @@index([compradorId, criadoEm(sort: Desc)])
}

model ItemPedido {
  id            String   @id @default(uuid()) @db.Uuid
  pedidoId      String   @db.Uuid
  produtoId     String   @db.Uuid
  quantidade    Int
  precoUnitario Decimal? @db.Decimal(10, 2)
  subtotal      Decimal? @db.Decimal(10, 2)
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([pedidoId])
  @@index([produtoId])
}

model Pagamento {
  id            String          @id @default(uuid()) @db.Uuid
  pedidoId      String          @unique @db.Uuid
  metodo        MetodoPagamento @default(pix_simulado)
  valor         Decimal         @db.Decimal(10, 2)
  status        StatusPagamento
  dataPagamento DateTime        @default(now()) @db.Timestamptz(3)
  pedido        Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model Avaliacao {
  id          String   @id @default(uuid()) @db.Uuid
  compradorId String   @db.Uuid
  produtoId   String   @db.Uuid
  nota        Int
  comentario  String?
  criadoEm    DateTime @default(now()) @db.Timestamptz(3)
  comprador   Usuario  @relation(fields: [compradorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  produto     Produto  @relation(fields: [produtoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([compradorId, produtoId])
  @@index([produtoId])
}

// Estrutura tecnica da fila (nao conta entre as onze entidades de dominio).
model IntencaoNotificacao {
  id           String         @id @default(uuid()) @db.Uuid
  pedidoId     String         @unique @db.Uuid
  status       StatusIntencao @default(pendente)
  tentativas   Int            @default(0)
  criadoEm     DateTime       @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime       @updatedAt @db.Timestamptz(3)
  processadaEm DateTime?      @db.Timestamptz(3)
  pedido       Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status])
}

// Estrutura tecnica de notificacao (fora das onze entidades de dominio).
model Notificacao {
  id        String          @id @default(uuid()) @db.Uuid
  usuarioId String          @db.Uuid
  pedidoId  String          @db.Uuid
  tipo      TipoNotificacao
  lida      Boolean         @default(false)
  criadoEm  DateTime        @default(now()) @db.Timestamptz(3)
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pedido    Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([usuarioId, pedidoId, tipo])
  @@index([pedidoId])
  @@index([usuarioId, lida, criadoEm(sort: Desc)])
}
