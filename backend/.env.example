# Valores fictícios. Substitua as URLs antes de executar.
DATABASE_URL=postgresql://usuario_ficticio:senha_ficticia@localhost:5432/origem
DIRECT_URL=postgresql://usuario_ficticio:senha_ficticia@localhost:5432/origem
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Somente exemplo. Em produção, gere um segredo aleatório exclusivo.
JWT_SECRET=exemplo-ficticio-nao-usar-em-producao-123456789
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
CACHE_TTL_SECONDS=60
NOTIFICATION_PUBLISHER_INTERVAL_MS=3000
RUN_WORKER_IN_API=true
# Validada nesta entrega; concorrencia interna sera implementada em 30.5.
WORKER_CONCURRENCY=1

# Volume somente na branch Neon de teste, com autorização explícita.
ALLOW_VOLUME_SEED=0
DATABASE_URL_DEPLOY=postgresql://usuario_ficticio:senha_ficticia@deploy.example:5432/origem
# Scripts auxiliares; não alteram o PORT do servidor regular.
CONCURRENCY_TEST_PORT=3910
CONCURRENCY_TEST_CLIENTS=50

# IA-04: conexao da branch sintetica de volume, usada somente para leitura.
# O modo --isolado usa DIRECT_URL e dispensa esta variavel.
DATABASE_URL_VOLUME=
