# Somente demonstração local. Troque todas as senhas e tokens.
# Use senhas com 32+ caracteres alfanuméricos nas URLs.
POSTGRES_DB=origem
POSTGRES_USER=origem_admin
POSTGRES_PASSWORD=troque_admin_local_0123456789abcdef
API_DATABASE_PASSWORD=troque_api_local_0123456789abcdef01
RECOMENDACAO_DATABASE_PASSWORD=troque_rec_local_0123456789abcdef01
JWT_SECRET=troque_jwt_local_0123456789abcdef01
RECOMENDACAO_SERVICE_TOKEN=troque_token_local_0123456789abcdef
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
RECOMENDACAO_TIMEOUT_MS=800
CACHE_TTL_SECONDS=60
WORKER_CONCURRENCY=1
NOTIFICATION_PUBLISHER_INTERVAL_MS=3000
